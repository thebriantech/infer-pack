# InferPack Configuration - Environment Overrides
# Copy to .env and customize.

# Server
INFERPACK_SERVER_HOST=0.0.0.0
INFERPACK_SERVER_PORT=9000
INFERPACK_SERVER_LOG_LEVEL=info

# Triton Inference Server
INFERPACK_TRITON_HOST=triton
INFERPACK_TRITON_HTTP_PORT=8000
INFERPACK_TRITON_GRPC_PORT=8001
INFERPACK_TRITON_MODEL_REPOSITORY=/models

# Model lifecycle
INFERPACK_MODEL_IDLE_TIMEOUT=300

# Pipeline directories
INFERPACK_BUILTIN_PIPELINES_DIR=pipelines/builtins
INFERPACK_CUSTOM_PIPELINES_DIR=pipelines/custom
